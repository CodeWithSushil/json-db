{
    "name": "jsondbphp/jsondb",
    "description": "JsonDB: Lightweight Document Container for Modern PHP Apps.",
    "type": "library",
    "keywords": [
      "jsondb",
      "jsondbphp",
      "json database",
      "database"
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "tomasvotruba/type-coverage": "^2.4"
    },
    "license": "MIT",
    "autoload": {
      "psr-4": {
        "Json\\Database\\": "src/"
      }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "scripts": {
        "pint": "pint --parallel",
        "analyse": "phpstan analyse",
        "lint": [
          "@pint",
          "@analyse"
        ],
        "pint:test": "pint --parallel --test",
        "unit": "vendor/bin/phpunit",
        "test": [
          "@pint:test",
          "@analyse",
          "@unit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true   
}
